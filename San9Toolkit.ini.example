; The GUI creates data\San9Toolkit.ini automatically.
; Omitted values use the original game's compiled defaults.

[Toolkit]
GameExecutable=
; Replaces the Windows Documents root inside the game process. The game appends
; Koei\San9 Tc and Koei\San9PK Tc itself. Leave empty to use the system location.
DocumentsRoot=
CursorLockVirtualKey=123
ScaleInitialWindowForSystemDpi=1
WindowTitle=三國志ⅨPK
BorderlessWindow=0
GameSpeedMultiplier=2

[Configs]
; Toolkit rendering requires windowed mode. This is forced to 0 even when omitted.
FullScreen=0

; Common binary switches: 0 = off, 1 = on.
PlayBGM=1
PlaySound=1
PlayMovie=1

; Confirmed original labels:
; MessageSpeed: 0 = Fast, 1 = Normal, 2 = Pause.
; GameReport: 0 = Off, 1 = Summary, 2 = Detailed.
; GameSpeed is deliberately omitted: the target game persists it but has no
; confirmed runtime consumer, and Toolkit's built-in 2x clock does not read it.
; The exact labels for the remaining three-state options are not yet confirmed.
MessageSpeed=1
GameReport=1
; Map edge scrolling: bit 0x1000 set = hover, clear = hold left button.
; 7681 (0x1E01) is the original compiled default and selects hover.
FlagData=7681
GameReportDlg=1
JumpList=1
SvLdPage=0

; The remaining Configs values are game-managed state. They are listed so the
; virtual registry inventory is complete. Leave them omitted unless diagnosing
; a specific value; the game writes them here when it saves its configuration.
;
; Dialog and main-window positions:
; YNPositionX=
; YNPositionY=
; KakuninPositionX=
; KakuninPositionY=
; AppPositionX=
; AppPositionY=
;
; Other packed game state. FlagData is maintained by the GUI while preserving
; every bit except the confirmed edge-scroll bit:
; ArtData=
;
; Trial-story progress:
; TrialStory00=
; TrialStory01=
; TrialStoryEvent=
; TrialStoryClear=
